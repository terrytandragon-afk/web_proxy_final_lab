{
  "listen_host": "127.0.0.1",
  "listen_port": 8080,
  "admin_host": "127.0.0.1",
  "admin_port": 8088,
  "mode": "blacklist",
  "blocked_domains": [
    "blocked.test",
    "example-blocked.com",
    "*.badsite.test"
  ],
  "allowed_domains": [
    "127.0.0.1",
    "localhost",
    "example.com"
  ],
  "blocked_url_keywords": [],
  "blocked_content_keywords": [
    "forbidden",
    "attack",
    "virus",
    "secret"
  ],
  "replace_keywords": {
    "advertisement": "***"
  },
  "blocked_methods": [
    "PUT",
    "DELETE"
  ],
  "timeout_seconds": 10,
  "max_clients": 50,
  "cache_enabled": true,
  "cache_ttl_seconds": 60,
  "cache_max_items": 100,
  "proxy_auth_enabled": false,
  "proxy_auth_users": {
    "student": "123456"
  },
  "rate_limit_enabled": false,
  "rate_limit_per_minute": 60,
  "rate_limit_window_seconds": 60,
  "log_file": "logs/proxy.log",
  "blocked_log_file": "logs/blocked.log",
  "error_log_file": "logs/error.log",
  "change_log_file": "logs/changes.jsonl"
}
